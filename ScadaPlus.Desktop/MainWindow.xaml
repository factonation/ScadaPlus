<Window x:Class="ScadaPlus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScadaPlus.Desktop"
        xmlns:views="clr-namespace:ScadaPlus.Desktop.Views"
        mc:Ignorable="d"
        Title="ScadaPlus" Height="800" Width="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <views:ClientView x:Name="ClientView1" Grid.Column="0" MachineName="Mitsubishi PLC Server" IpAddress="169.254.1.2" HubPath="hub-1" />
        <views:ClientView x:Name="ClientView2" Grid.Column="1" MachineName="Amsamotion PLC Server" IpAddress="169.254.1.3" HubPath="hub-2" />
        <views:ClientView x:Name="ClientView3" Grid.Column="2" MachineName="Delta PLC Server" IpAddress="169.254.1.4" HubPath="hub-3" />
    </Grid>
</Window>
